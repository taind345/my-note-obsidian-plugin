{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MyBook",
  "version": "0.1.0",
  "identifier": "com.mybook.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "MyBook — Sổ tay lai số & giấy",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Sổ tay lai: vở vật lý + markdown + vault Obsidian",
    "longDescription": "MyBook — sổ tay vật lý số hoá: vẽ tay, textbox markdown, ảnh paste, vault Obsidian, xuất PDF."
  }
}
