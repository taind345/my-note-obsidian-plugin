{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0",
    "paths": { "@/*": ["../src/*"] }
  },
  "include": [
    "src/**/*",
    "../src/shared/types/notebook.ts",
    "../src/shared/lib/markdown.ts",
    "../src/shared/lib/debounce.ts",
    "../src/shared/lib/imagePaste.ts",
    "../src/shared/lib/selection.ts",
    "../src/shared/lib/smoothing.ts",
    "../src/shared/lib/lineSnap.ts",
    "../src/shared/lib/fonts.ts",
    "../src/shared/lib/tauriFs.ts",
    "../src/services/markdownFile.ts",
    "../src/services/storage.ts",
    "../src/features/notebook/components/NotebookPage.tsx",
    "../src/features/notebook/components/NotebookTextBox.tsx",
    "../src/features/notebook/components/PageCanvas.tsx",
    "../src/features/notebook/components/PageImageLayer.tsx",
    "../src/shared/ui/PageNavigator.tsx",
    "../src/features/markdown/toolbar/ObsidianMarkdownToolbar.tsx",
    "../src/features/notebook/components/ExcalidrawPageCanvas.tsx"
  ]
}
